@model IEnumerable<ControleDePresenca.Models.Participante>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.ParticipanteNome)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Matriculas)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Eventos)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ParticipanteNome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Matriculas)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Eventos.EventoId)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ParticipanteID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ParticipanteID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ParticipanteID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
